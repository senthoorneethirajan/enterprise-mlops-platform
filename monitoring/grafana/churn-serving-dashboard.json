{
  "title": "Churn Serving — Production Monitoring",
  "uid": "churn-serving",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["mlops", "task-05"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inference latency (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(inference_latency_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(inference_latency_seconds_bucket[5m])))",
          "legendFormat": "p50"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate (%)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "100 * (sum(rate(inference_requests_total{status=~\"5..\"}[5m])) or vector(0)) / sum(rate(inference_requests_total[5m]))",
          "legendFormat": "5xx error rate"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request rate by model version (canary split)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (model_version) (rate(inference_requests_total[5m]))",
          "legendFormat": "{{model_version}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Deployment health (serving targets up)",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(up{job=\"churn-serving\"})", "legendFormat": "pods up" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Data drift PSI by feature (alert threshold 0.2)",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.2 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "max by (feature) (drift_psi)", "legendFormat": "{{feature}}" }
      ]
    }
  ]
}
